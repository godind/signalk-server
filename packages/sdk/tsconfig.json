{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "references": [
    {
      "path": "../server-api"
    }
  ],
  "include": ["./src/**/*"],
  "exclude": ["./test/**/*", "./smoke-test-client/**/*"]
}
